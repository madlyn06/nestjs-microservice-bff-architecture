PORT=3400
INVOICE_PORT=3001
PRODUCT_PORT=3002
USER_ACCESS_PORT=3003

GLOBAL_PREFIX=api/v2

# TCP
INVOICE_SERVICE_HOST=localhost
TCP_INVOICE_SERVICE_PORT=3201

PRODUCT_SERVICE_HOST=localhost
TCP_PRODUCT_SERVICE_PORT=3202

USER_ACCESS_SERVICE_HOST=localhost
TCP_USER_ACCESS_SERVICE_PORT=3203

# MONGODB
MONGODB_URI=mongodb://root:password@localhost:27017
MONGODB_DB_NAME=e-invoice
MONGODB_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=15000
MONGODB_SOCKET_TIMEOUT_MS=360000

# POSTGRES
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=root
DB_POSTGRES_PASSWORD=password
DB_POSTGRES_DB=e-invoice
DB_POSTGRES_TYPE=postgres